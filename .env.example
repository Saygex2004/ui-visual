# =============================================================================
# pvp-dashboard — environment example (CONFIGURATION.md)
# Copy to `.env` for local development. Never put real secrets in this file.
# A missing/malformed REQUIRED variable makes apps/server refuse to start,
# naming the offending variable.
# =============================================================================

# --- Server: required (CONFIGURATION.md §1) ---------------------------------
# The shared Firebase project id (the `pvp-aste-…` id). For local emulator work
# any non-empty value works.
PVPDASH_FIRESTORE_PROJECT_ID=pvp-dashboard-local
# Service-account JSON for the Admin SDK — LOCAL/DEV ONLY. Unset on Cloud Run.
GOOGLE_APPLICATION_CREDENTIALS=<path-to-service-account.json>
# HMAC key for session-cookie integrity — MUST be >= 32 chars.
PVPDASH_SESSION_SECRET=<random-string-at-least-32-characters-long>
# Initial admin password, used ONLY when the `users` collection is empty.
# Remove from the environment after first bootstrap.
PVPDASH_BOOTSTRAP_ADMIN_PASSWORD=<initial-admin-password>

# --- Server: optional (CONFIGURATION.md §2 — defaults shown) ----------------
PVPDASH_PORT=8080
PVPDASH_ENV=development
PVPDASH_META_POLL_SECONDS=60
PVPDASH_SNAPSHOT_MAX_AGE_HOURS=24
PVPDASH_SESSION_TTL_DAYS=30
PVPDASH_ATTACH_MAX_MB=10
PVPDASH_ATTACH_TYPES=image/png,image/jpeg,image/webp,application/pdf
PVPDASH_STORAGE_BUCKET=<project-default-bucket>
PVPDASH_SIGNED_URL_TTL_MINUTES=15
PVPDASH_MESSAGE_MAX_CHARS=4000
PVPDASH_CALENDAR_DAILY_TARGET=18
PVPDASH_LOG_LEVEL=info

# --- Emulator / test environment (CONFIGURATION.md §3) ----------------------
# Set these to route the Admin SDK to the local emulators. Their ABSENCE is
# what "production access" means; the integration suites require them.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8081
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
# Set to 1 to load listings/OMI/meta/runs/settings fixtures at dev startup
# (never accounts — see CONFIGURATION.md §3).
PVPDASH_SEED=0
# Set to 1 to wipe users/usernames/sessions before bootstrap runs (e2e only).
PVPDASH_RESET_ACCOUNTS_ON_BOOT=0

# --- Web app: build-time (CONFIGURATION.md §4) ------------------------------
# API origin+prefix. Default works in prod (Hosting rewrite) and dev (Vite proxy).
VITE_API_BASE=/api
