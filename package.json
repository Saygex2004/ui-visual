{
  "name": "pvp-dashboard",
  "version": "0.0.0",
  "private": true,
  "description": "PVP Aste Dashboard — Italian judicial-auctions review app (monorepo)",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "pnpm -r --parallel test",
    "test:integration": "firebase emulators:exec --config firebase/firebase.json --project demo-pvp-dashboard \"pnpm -r test:integration\"",
    "e2e": "firebase emulators:exec --config firebase/firebase.json --project demo-pvp-dashboard \"playwright test\"",
    "build": "pnpm -r build",
    "dev:server": "pnpm --filter @pvp/server dev",
    "dev:web": "pnpm --filter @pvp/web dev",
    "emulators": "cd firebase && firebase emulators:start --project demo-pvp-dashboard",
    "seed": "tsx seed/seed.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "fflate": "^0.8.3",
    "firebase-admin": "^14.2.0",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  }
}
