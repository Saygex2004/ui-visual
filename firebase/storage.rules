rules_version = '2';

// Deny-all: attachment uploads/downloads are mediated by the Fastify API via
// the Admin SDK; the browser never touches Storage directly. Downloads use
// short-lived signed URLs (SPECIFICATIONS.md §11). Hardened in Phase 10.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
